{
  // Markdown linting for this repository. Run it with `just lint` or `just check`, which use
  // the version pinned in package.json. Never use `npx markdownlint-cli2` (AGENTS.md).
  // Formatting is prettier's job (--prose-wrap preserve); this file only turns
  // off the rule that conflicts with that.
  "config": {
    "default": true,

    // Prose is one sentence per line, unwrapped, which prettier preserves and which
    // keeps diffs readable. A column limit would fail on every long sentence.
    "MD013": false,
  },
  "globs": ["**/*.md"],
  // .claude/skills is a local symlink to skills/ (see AGENTS.md: Skills), and
  // markdownlint follows symlinks, so linting it reports every finding twice.
  // target/ is Cargo's build output.
  "ignores": ["node_modules", ".claude", "target"],
}
