{
  // Spell checking for this repository. Run via `npm run spell` or `npm run check`,
  // which use the version pinned in package.json. Editors with a cspell extension
  // read this file too, so the editor and CI flag the same words.
  "version": "0.2",

  // British spelling, per AGENTS.md: Spelling. en-US would flag every
  // "behaviour"; the flagWords below catch the American forms en-GB misses.
  "language": "en-GB",
  "dictionaries": ["rust", "softwareTerms", "npm", "bash", "repository-words"],

  // Names, identifiers, and terms the dictionaries lack. addWords lets the
  // editor's "add to dictionary" action write here.
  "dictionaryDefinitions": [
    {
      "name": "repository-words",
      "path": "./cspell.words.txt",
      "addWords": true,
    },
  ],

  "useGitignore": true,
  // .claude/skills is a local symlink to skills/ (see .markdownlint-cli2.jsonc).
  // The others are machine-written.
  "ignorePaths": [
    "node_modules",
    ".claude",
    "target",
    "package-lock.json",
    "assets/diagrams",
  ],

  "overrides": [
    {
      // A string escape in Rust runs into the word after it: "\nrustflags"
      // reads as "nrustflags". Skip the escape so the word is checked alone.
      "filename": "**/*.rs",
      "ignoreRegExpList": ["/\\\\[nrt]/g"],
    },
    {
      // Skip what the shared Writing style's Scope of these rules keeps as written: link text
      // (usually a third-party title), inline code (an identifier someone else
      // named), and a quotation.
      "filename": "**/*.md",
      "ignoreRegExpList": [
        "/\\[[^\\]\\n]*\\]\\(/g",
        "/`[^`\\n]+`/g",
        "/\"[^\"\\n]*\"/g",
      ],
      // The dictionaries cspell enables by default accept these, because API
      // and crate names use them (Color, analyze), so en-GB alone lets them
      // through in prose. Code files aren't covered: an identifier keeps the
      // crate's spelling.
      // cspell:disable
      "flagWords": [
        "behavior",
        "behaviors",
        "behavioral",
        "color",
        "colors",
        "colored",
        "defense",
        "defenses",
        "catalog",
        "catalogs",
        "modeling",
        "modeled",
        "favor",
        "favors",
        "favorite",
        "honor",
        "center",
        "centered",
        "analyze",
        "analyzed",
        "analyzes",
        "analyzing",
        "practiced",
        "canceled",
        "canceling",
        "labeled",
        "labeling",
        "traveled",
        "fulfill",
        "judgment",
        "gray",
      ],
      // cspell:enable
    },
  ],
}
